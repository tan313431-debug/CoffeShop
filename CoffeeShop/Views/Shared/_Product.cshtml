@model IEnumerable<CoffeeShop.Models.Product>

<div class="row mt-4">
    @foreach (var item in Model)
    {
        <div class="item features-image col-12 col-md-6 col-lg-4">
            <div class="item-wrapper">
                <div class="item-img">
                    <img src="@item.ImageUrl" alt="@item.Name">
                </div>
                <div class="item-content">
                    <a asp-controller="Products" asp-action="Detail" asp-route-id="@item.Id">
                        <h6 class="item-subtitle mbr-fonts-style mt-1 display-7">
                            <strong>@item.Name</strong>
                        </h6>
                    </a>
                    <p class="mbr-text mbr-fonts-style mt-3 display-7">@item.Price.ToString("$#,##0.00")
                </div>
                <div class="mbr-section-btn item-footer mt-2">
                    <a asp-controller="ShoppingCart" asp-action="AddToShoppingCart" asp-route-pId="@item.Id"
                       class="btn item-btn btn-primary display-4">
                        <span class="fas fa-cart-plus mbr-iconfont mbr-iconfont-btn"></span> Add to cart
                    </a>
                </div>
            </div>
        </div>
    }
</div>