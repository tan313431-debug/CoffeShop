@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <a style="display:block; color:#ffffff; padding: 8px 16px;"
       asp-controller="Home" asp-action="MyOrders">My Orders</a>
    <form asp-area="Identity" asp-page="/Account/Logout"
          asp-route-returnUrl="/" method="post">
        <button type="submit"
                style="display:block; width:100%; text-align:left; background:none; border:none; color:#ffffff; padding: 8px 16px;">
            Logout
        </button>
    </form>
}
else
{
    <a style="display:block; color:#ffffff; padding: 8px 16px;"
       asp-area="Identity" asp-page="/Account/Register">Register</a>
    <a style="display:block; color:#ffffff; padding: 8px 16px;"
       asp-area="Identity" asp-page="/Account/Login">Login</a>
}