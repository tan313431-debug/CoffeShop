@model IEnumerable<CoffeeShop.Models.Order>
@{
    ViewData["Title"] = "List your orders";
}

<div class="container py-5">
    <h2>List your orders</h2>
    <table class="table mt-4">
        <thead>
            <tr>
                <th>Stt</th>
                <th>Time order</th>
                <th>Detail</th>
                <th>Shipping Address</th>
                <th>Total</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @{
                int stt = 1;
            }
            @foreach (var order in Model)
            {
                <tr>
                    <td>@stt</td>
                    <td>@order.OrderPlaced.ToString("dd/MM/yyyy h:mm:ss tt")</td>
                    <td>
                        @foreach (var detail in order.OrderDetails!)
                        {
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <img src="@detail.Product?.ImageUrl" style="width:60px; height:50px; object-fit:cover;" />
                                <span>@detail.Quantity x @detail.Product?.Name x @detail.Price.ToString("0.00")</span>
                            </div>
                        }
                    </td>
                    <td>@order.Address</td>
                    <td>@order.OrderTotal.ToString("0.00")</td>
                    <td style="color: green;">Success</td>
                </tr>
                stt++;
            }
        </tbody>
    </table>
</div>